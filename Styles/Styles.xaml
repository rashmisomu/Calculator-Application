<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#3CCBFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="5" BorderBrush="#3CCBFF" BorderThickness="0" >

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#36454F"/>
                            <Setter TargetName="border" Property="Opacity" Value="1"/>

                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border"  Property="Background" Value="#36454F"/>
                            <Setter TargetName="border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    
    <Style x:Key="myToolTip" TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
                        <ContentPresenter 
                        Content="{TemplateBinding Content}" 
                        />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="menuButtons" TargetType="Button">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#FF3A3A3A"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="Width" Value="185"/>
        <Setter  Property="Opacity" Value="1"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="5" Padding="8" BorderBrush="#3CCBFF" BorderThickness="0" >

                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#36454F"/>
                            <Setter TargetName="border" Property="Opacity" Value="1"/>

                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border"  Property="Background" Value="#36454F"/>
                            <Setter TargetName="border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    <Style x:Key="historyButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#3CCBFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="15" BorderBrush="#3CCBFF" BorderThickness="0" Background="#FF1E1E1E">

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#36454F"/>
                            <Setter TargetName="border" Property="Opacity" Value="1"/>
                            

                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border"  Property="Background" Value="#36454F"/>
                            <Setter TargetName="border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="MemoryButton" TargetType="Button">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="40"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Foreground" Value="#C33EFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border  Name="Memborder" CornerRadius="5" Padding="0" 
                   BorderThickness="0.1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>

                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Memborder" Property="Background" Value="#C5BAFF"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Memborder" Property="Background" Value="#36454F"/>
                           
                            <Setter TargetName="Memborder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Memborder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="False">

                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="myButton" TargetType="Button">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="FontSize" Value="18"/> 
        <Setter Property="Foreground" Value="#3CCBFF"/>
        <Setter Property="Background" Value="Black"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border  x:Name="border" Background="{TemplateBinding Background}"
                         CornerRadius="12"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3CCBFF"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="Opacity" Value="1"/>

                            <Setter Property="FontSize" Value="27"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#3A3A4A"/>
                            <Setter TargetName="border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">


                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>
     <Style x:Key="OperationButton" TargetType="Button">
     <Setter Property="Width" Value="60"/>
     <Setter Property="Height" Value="60"/>
     <Setter Property="Margin" Value="5"/>
     <Setter Property="FontSize" Value="18"/>
     
        <Setter Property="Foreground" Value="#C33EFF"/>
     <Setter Property="Background" Value="Black"/>
     <Setter Property="BorderBrush" Value="Transparent"/>
     
     <Setter Property="Template">
         <Setter.Value>
             <ControlTemplate TargetType="Button">
                 <Border  x:Name="border" Background="{TemplateBinding Background}"
                      CornerRadius="12"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1">
                     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                 </Border>
                 <ControlTemplate.Triggers>
                     <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#C5BAFF"/>
                         <Setter Property="Foreground" Value="Black"/>
                         <Setter Property="Opacity" Value="1"/>

                         <Setter Property="FontSize" Value="27"/>
                     </Trigger>
                     <Trigger Property="IsPressed" Value="True">
                         <Setter Property="Background" Value="#3A3A4A"/>
                         <Setter TargetName="border" Property="RenderTransform">
                             <Setter.Value>
                                 <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                             </Setter.Value>
                         </Setter>
                         <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                     </Trigger>
                 </ControlTemplate.Triggers>
             </ControlTemplate>
         </Setter.Value>
     </Setter>
     <Style.Triggers>
         <Trigger Property="IsEnabled" Value="False">


             <Setter Property="Opacity" Value="0.6"/>
         </Trigger>
     </Style.Triggers>
 </Style>
    
 <Style x:Key="EqualButton" TargetType="Button" BasedOn="{StaticResource myButton}">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Background" Value="#C33EFF" />
     <Setter Property="Opacity" Value="0.8"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="Foreground" Value="Black"/>
     <!-- Make text readable -->
     <Setter Property="FontWeight" Value="Bold"/>
     <!-- Make text bold -->
     <Setter Property="Template">
         <Setter.Value>
             <ControlTemplate TargetType="Button">
                 <Border Name="EqualBorder" Background="{TemplateBinding Background}" 
                 CornerRadius="12" BorderBrush="#C33EFF"
                 Padding="0" BorderThickness="1">
                     <ContentPresenter HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                 </Border>
                 <ControlTemplate.Triggers>
                     <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#C5BAFF"/>
                         <Setter Property="Opacity" Value="1"/>

                         <Setter Property="FontSize" Value="25"/>

                     </Trigger>
                     <Trigger Property="IsPressed" Value="True">
                         <Setter TargetName="EqualBorder" Property="Background" Value="#a28ad2"/>
                         <Setter TargetName="EqualBorder" Property="RenderTransform">
                             <Setter.Value>
                                 <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                             </Setter.Value>
                         </Setter>
                         <Setter TargetName="EqualBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                     </Trigger>
                 </ControlTemplate.Triggers>
             </ControlTemplate>
         </Setter.Value>
     </Setter>
 </Style>

</ResourceDictionary>